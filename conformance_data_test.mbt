  ("07-edge.jsonl:65", "{{(print 1) | print | print | print}}", "null", "ok", "1"),
  ("07-edge.jsonl:66", "{{print (len .a) (len .b) (len .c)}}", "{\"a\": [1], \"b\": \"xy\", \"c\": {}}", "ok", "1 2 0"),
  ("07-edge.jsonl:67", "{{index (index . \"a\") 1}}", "{\"a\": [5, 6]}", "ok", "6"),
  ("07-edge.jsonl:68", "{{len (index . 0)}}", "[[1, 2, 3]]", "ok", "3"),
  ("07-edge.jsonl:69", "{{(index . 0 | len) | printf \"%03d\"}}", "[\"abcd\"]", "ok", "004"),
  ("07-edge.jsonl:70", "{{printf \"%s has %d\" .name (len .items)}}", "{\"name\": \"cart\", \"items\": [1, 2]}", "ok", "cart has 2"),
  ("07-edge.jsonl:71", "{{with $x := index . 0}}{{with $y := index $ 1}}{{$x}}{{$y}}{{end}}{{end}}", "[\"a\", \"b\"]", "ok", "ab"),
  ("07-edge.jsonl:72", "{{range $i, $e := .}}{{if and (gt $i 0) (lt $i 3)}}{{$e}}{{end}}{{end}}", "[\"a\", \"b\", \"c\", \"d\"]", "ok", "bc"),
  ("07-edge.jsonl:73", "{{$total := 0}}{{range .}}{{$total = len (print $total .)}}{{end}}{{$total}}", "[1, 2, 3]", "ok", "3"),
  ("07-edge.jsonl:74", "{{range $k, $v := .}}{{range $v}}{{$k}}{{.}} {{end}}{{end}}", "{\"a\": [1, 2], \"b\": [3]}", "ok", "a1 a2 b3 "),
  ("07-edge.jsonl:75", "{{if eq (len .) 0}}empty{{else if eq (len .) 1}}one{{else}}many{{end}}", "[1, 2]", "ok", "many"),
  ("07-edge.jsonl:76", "{{if and}}{{end}}", "null", "exec", ""),
  ("07-edge.jsonl:77", "{{$first := true}}{{range .}}{{if $first}}{{$first = false}}{{else}}, {{end}}{{.}}{{end}}", "[\"a\", \"b\", \"c\"]", "ok", "a, b, c"),
  ("07-edge.jsonl:79", "{{range .items}}- {{.name}}: {{printf \"%.2f\" .price}}\n{{end}}Total: {{len .items}} items", "{\"items\": [{\"name\": \"tea\", \"price\": 3.5}, {\"name\": \"cup\", \"price\": 12.0}]}", "ok", "- tea: 3.50\n- cup: 12.00\nTotal: 2 items"),
  ("07-edge.jsonl:80", "apiVersion: v1\nkind: {{.kind}}\nmetadata:\n  name: {{.name | printf \"%s-svc\"}}\n{{- if .labels}}\n  labels:\n{{- range $k, $v := .labels}}\n    {{$k}}: {{$v | printf \"%q\"}}\n{{- end}}\n{{- end}}\n", "{\"kind\": \"Service\", \"name\": \"web\", \"labels\": {\"app\": \"web\", \"tier\": \"front\"}}", "ok", "apiVersion: v1\nkind: Service\nmetadata:\n  name: web-svc\n  labels:\n    app: \"web\"\n    tier: \"front\"\n"),
  ("07-edge.jsonl:81", "apiVersion: v1\nkind: {{.kind}}\nmetadata:\n  name: {{.name | printf \"%s-svc\"}}\n{{- if .labels}}\n  labels:\n{{- range $k, $v := .labels}}\n    {{$k}}: {{$v | printf \"%q\"}}\n{{- end}}\n{{- end}}\n", "{\"kind\": \"Service\", \"name\": \"web\"}", "ok", "apiVersion: v1\nkind: Service\nmetadata:\n  name: web-svc\n"),
  ("07-edge.jsonl:82", "{{range .}}{{.ID}}\t{{.Image}}\t{{.Status}}\n{{end}}", "[{\"ID\": \"abc\", \"Image\": \"nginx\", \"Status\": \"Up\"}, {\"ID\": \"def\", \"Image\": \"redis\", \"Status\": \"Exited\"}]", "ok", "abc\tnginx\tUp\ndef\tredis\tExited\n"),
  ("07-edge.jsonl:83", "{{define \"li\"}}<li>{{html .}}</li>{{end}}<ul>{{range .}}{{template \"li\" .}}{{end}}</ul>", "[\"a<b\", \"c&d\"]", "ok", "<ul><li>a&lt;b</li><li>c&amp;d</li></ul>"),
  ("07-edge.jsonl:84", "Hello, {{or .name \"stranger\"}}!{{if .admin}} (admin){{end}}", "{\"name\": \"Ada\", \"admin\": true}", "ok", "Hello, Ada! (admin)"),
  ("07-edge.jsonl:85", "Hello, {{or .name \"stranger\"}}!{{if .admin}} (admin){{end}}", "{}", "ok", "Hello, stranger!"),
  ("07-edge.jsonl:86", "{{range $i, $u := .users}}{{if $i}}, {{end}}{{$u.name}} <{{$u.email}}>{{end}}", "{\"users\": [{\"name\": \"A\", \"email\": \"a@x\"}, {\"name\": \"B\", \"email\": \"b@x\"}]}", "ok", "A <a@x>, B <b@x>"),
  ("07-edge.jsonl:87", "{{with .error}}ERROR: {{.}}{{else}}OK ({{len .results}} results){{end}}", "{\"results\": [1, 2, 3]}", "ok", "OK (3 results)"),
  ("07-edge.jsonl:88", "{{with .error}}ERROR: {{.}}{{else}}OK ({{len .results}} results){{end}}", "{\"error\": \"boom\"}", "ok", "ERROR: boom"),
  ("07-edge.jsonl:89", "https://example.com/search?q={{urlquery .q}}&page={{.page}}", "{\"q\": \"go templates & more\", \"page\": 2}", "ok", "https://example.com/search?q=go+templates+%26+more&page=2"),
  ("07-edge.jsonl:90", "<script>var name = '{{js .}}';</script>", "\"O'Reilly </script>\"", "ok", "<script>var name = 'O\\'Reilly \\u003C/script\\u003E';</script>"),
  ("07-edge.jsonl:91", "{{printf \"%-10s|%5d|%8.2f\" .name .qty .price}}", "{\"name\": \"widget\", \"qty\": 7, \"price\": 19.999}", "ok", "widget    |    7|   20.00"),
  ("07-edge.jsonl:92", "{{range .}}{{printf \"%3d%%\" .}} {{end}}", "[5, 50, 100]", "ok", "  5%  50% 100% "),
  ("known-differences.jsonl:7", "{{range .}}{{.a}}{{end}}", "[null]", "exec", ""),
  ("known-differences.jsonl:8", "{{range .}}{{.a}}{{end}}", "{\"k\": null}", "exec", ""),
  ("known-differences.jsonl:9", "{{range $i, $v := .}}{{$v.a}}{{end}}", "[null]", "exec", ""),
  ("known-differences.jsonl:11", "{{1i}}", "null", "ok", "(0+1i)"),
  ("known-differences.jsonl:12", "{{print 2.5i}}", "null", "ok", "(0+2.5i)"),
  ("known-differences.jsonl:15", "{{len \"\\xff\"}}", "null", "ok", "1"),
  ("known-differences.jsonl:16", "{{len \"\\377\"}}", "null", "ok", "1"),
]
