["{{index (index . \"a\") 1}}", {"a": [5, 6]}]
["{{len (index . 0)}}", [[1, 2, 3]]]
["{{(index . 0 | len) | printf \"%03d\"}}", ["abcd"]]
["{{printf \"%s has %d\" .name (len .items)}}", {"name": "cart", "items": [1, 2]}]
["{{with $x := index . 0}}{{with $y := index $ 1}}{{$x}}{{$y}}{{end}}{{end}}", ["a", "b"]]
