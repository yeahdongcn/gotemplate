["{{with .error}}ERROR: {{.}}{{else}}OK ({{len .results}} results){{end}}", {"results": [1, 2, 3]}]
["{{with .error}}ERROR: {{.}}{{else}}OK ({{len .results}} results){{end}}", {"error": "boom"}]
