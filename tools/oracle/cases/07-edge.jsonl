# realistic templates
["{{range .items}}- {{.name}}: {{printf \"%.2f\" .price}}\n{{end}}Total: {{len .items}} items", {"items": [{"name": "tea", "price": 3.5}, {"name": "cup", "price": 12.0}]}]
["apiVersion: v1\nkind: {{.kind}}\nmetadata:\n  name: {{.name | printf \"%s-svc\"}}\n{{- if .labels}}\n  labels:\n{{- range $k, $v := .labels}}\n    {{$k}}: {{$v | printf \"%q\"}}\n{{- end}}\n{{- end}}\n", {"kind": "Service", "name": "web", "labels": {"app": "web", "tier": "front"}}]
["apiVersion: v1\nkind: {{.kind}}\nmetadata:\n  name: {{.name | printf \"%s-svc\"}}\n{{- if .labels}}\n  labels:\n{{- range $k, $v := .labels}}\n    {{$k}}: {{$v | printf \"%q\"}}\n{{- end}}\n{{- end}}\n", {"kind": "Service", "name": "web"}]
["{{range .}}{{.ID}}\t{{.Image}}\t{{.Status}}\n{{end}}", [{"ID": "abc", "Image": "nginx", "Status": "Up"}, {"ID": "def", "Image": "redis", "Status": "Exited"}]]
["{{define \"li\"}}<li>{{html .}}</li>{{end}}<ul>{{range .}}{{template \"li\" .}}{{end}}</ul>", ["a<b", "c&d"]]
["Hello, {{or .name \"stranger\"}}!{{if .admin}} (admin){{end}}", {"name": "Ada", "admin": true}]
["Hello, {{or .name \"stranger\"}}!{{if .admin}} (admin){{end}}", {}]
